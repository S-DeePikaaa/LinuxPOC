# Makefile - E-Commerce Order Processing System (POSIX mqueue + semaphores)
CC      ?= gcc
CFLAGS  := -std=gnu11 -Wall -Wextra -O2 -g -D_GNU_SOURCE
LDLIBS  := -lrt -pthread
SRC     := ipc.c services.c workers.c supervisor.c
BIN     := ecom_orders

.PHONY: all clean run test

all: $(BIN)

$(BIN): $(SRC) common.h
	$(CC) $(CFLAGS) -o $@ $(SRC) $(LDLIBS)

run: all
	./$(BIN)

# Runs every level and the failure-recovery demo; non-zero exit on failure.
test: all
	./$(BIN) -l 1 -n 10 -Q
	./$(BIN) -l 2 -n 15 -Q
	./$(BIN) -l 3 -n 15 -Q
	./$(BIN) -l 4 -n 20 -Q
	./$(BIN) -l 5 -n 20 -Q
	./$(BIN) -l 5 -n 25 -x 12 -Q

clean:
	rm -f $(BIN) *.log
